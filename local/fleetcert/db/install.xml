<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/fleetcert/db" VERSION="20261024" COMMENT="FleetCert training compliance schema">
  <TABLES>
    <TABLE NAME="local_fleetcert_org" COMMENT="local_fleetcert_org">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" />
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" />
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id" />
      </KEYS>
    </TABLE>
    <TABLE NAME="local_fleetcert_member" COMMENT="local_fleetcert_member">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" />
        <FIELD NAME="orgid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" />
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" />
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id" />
        <KEY NAME="orgid" TYPE="foreign" FIELDS="orgid" REFTABLE="local_fleetcert_org" REFFIELDS="id" />
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id" />
      </KEYS>
      <INDEXES>
        <INDEX NAME="identity" UNIQUE="true" FIELDS="userid" />
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_fleetcert_manager" COMMENT="local_fleetcert_manager">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" />
        <FIELD NAME="orgid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" />
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" />
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id" />
        <KEY NAME="orgid" TYPE="foreign" FIELDS="orgid" REFTABLE="local_fleetcert_org" REFFIELDS="id" />
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id" />
      </KEYS>
      <INDEXES>
        <INDEX NAME="identity" UNIQUE="true" FIELDS="orgid, userid" />
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_fleetcert_rule" COMMENT="local_fleetcert_rule">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" />
        <FIELD NAME="orgid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" />
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" />
        <FIELD NAME="validdays" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="365" />
        <FIELD NAME="reminddays" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="30" />
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id" />
        <KEY NAME="orgid" TYPE="foreign" FIELDS="orgid" REFTABLE="local_fleetcert_org" REFFIELDS="id" />
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id" />
      </KEYS>
      <INDEXES>
        <INDEX NAME="identity" UNIQUE="true" FIELDS="orgid, courseid" />
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_fleetcert_notice" COMMENT="local_fleetcert_notice">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" />
        <FIELD NAME="orgid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" />
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" />
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" />
        <FIELD NAME="expires" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" />
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id" />
        <KEY NAME="orgid" TYPE="foreign" FIELDS="orgid" REFTABLE="local_fleetcert_org" REFFIELDS="id" />
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id" />
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id" />
      </KEYS>
      <INDEXES>
        <INDEX NAME="identity" UNIQUE="true" FIELDS="orgid, userid, courseid, expires" />
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>